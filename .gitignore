.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.agents/
.gemini/
*.swp
*.swo
*~

# Logs and Runtime Data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Web Dependencies & Caches
node_modules/
.npm
.cache/
dist/
build/
.parcel-cache/

# Python Caches (for local testing servers)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Temporary and Scratch Files
tmp/
temp/
scratch/
*.tmp
*.bak

# Environment and Secrets
.env
.env.local
.env.*.local
*.pem
*.key
